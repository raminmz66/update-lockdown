#!/usr/bin/env bash
#
# update-lockdown — reversibly freeze every background update mechanism.
#
# The snapshot is always written to disk before anything is changed, so an
# interrupted lock is still fully recoverable with `unlock`.
#
set -euo pipefail

VERSION="1.0.0"

UL_STATE_DIR="${UL_STATE_DIR:-/var/lib/update-lockdown}"
UL_APT_CONF_DIR="${UL_APT_CONF_DIR:-/etc/apt/apt.conf.d}"
STATE_FILE="$UL_STATE_DIR/state.tsv"
BACKUP_DIR="$UL_STATE_DIR/backup"
APT_DROPIN="99-update-lockdown"

DRY_RUN=0
QUIET=0
FAILED=0

# snapd.snap-repair.timer is deliberately absent: it is Canonical's channel
# for repairing a broken snapd, and disabling it risks an unrecoverable snapd.
MANAGED_UNITS=(
  apt-daily.timer
  apt-daily-upgrade.timer
  apt-daily.service
  apt-daily-upgrade.service
  unattended-upgrades.service
  fwupd-refresh.timer
  packagekit-offline-update.service
  update-notifier-download.timer
  update-notifier-motd.timer
  motd-news.timer
  apt-news.service
)

log()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 3; }

# Run a command, tolerating failure so one bad item cannot abort a partial
# apply and strand the system between states.
try() {
  if [ "$DRY_RUN" -eq 1 ]; then
    log "  dry-run: $*"
    return 0
  fi
  if ! "$@" >/dev/null 2>&1; then
    warn "command failed: $*"
    FAILED=$((FAILED + 1))
    return 1
  fi
  return 0
}

need_root() {
  [ "${UL_ALLOW_NONROOT:-0}" = "1" ] && return 0
  [ "$(id -u)" -eq 0 ] || die "must be run as root (try: sudo update-lockdown $1)"
}

usage() {
  cat <<HELPTEXT
update-lockdown $VERSION — reversibly freeze background system updates

USAGE
  sudo update-lockdown lock      Snapshot the current state, then freeze updates
  sudo update-lockdown unlock    Restore that snapshot exactly, then forget it
       update-lockdown status    Report every managed item
  sudo update-lockdown enforce   Re-apply the frozen state (used at boot)

OPTIONS
  --dry-run    Print every action without changing anything
  --quiet      Suppress informational output
  --help       Show this help
  --version    Show the version

WHILE LOCKED
  Nothing installs on its own. Manual 'sudo apt upgrade' and 'sudo snap
  refresh' keep working exactly as before.

EXIT CODES
  0  success; for status: locked and consistent
  1  status: not locked
  2  status: locked but drifted
  3  usage error, missing privileges, or a failed operation
HELPTEXT
}

# ---------------------------------------------------------------- state ----

# systemctl exits non-zero for disabled/masked units but still prints the
# word, so failure is tolerated and empty output means the unit is absent.
unit_enabled_state() {
  local out
  out="$(systemctl is-enabled "$1" 2>/dev/null || true)"
  out="${out%%$'\n'*}"
  [ -n "$out" ] || out="not-found"
  printf '%s' "$out"
}

unit_active_state() {
  local out
  out="$(systemctl is-active "$1" 2>/dev/null || true)"
  out="${out%%$'\n'*}"
  if [ "$out" = "active" ]; then printf 'active'; else printf 'inactive'; fi
}

snap_hold_value() {
  local v
  command -v snap >/dev/null 2>&1 || { printf '__unset__'; return 0; }
  v="$(snap get system refresh.hold 2>/dev/null || true)"
  v="${v%%$'\n'*}"
  if [ -n "$v" ]; then printf '%s' "$v"; else printf '__unset__'; fi
}

is_locked() { [ -f "$STATE_FILE" ]; }

# Written atomically, and always before the first mutation.
state_write() {
  local tmp u
  mkdir -p "$UL_STATE_DIR"
  chmod 700 "$UL_STATE_DIR"
  tmp="$STATE_FILE.tmp.$$"
  {
    printf '#update-lockdown state - do not edit by hand\n'
    printf 'schema\t1\n'
    printf 'locked_at\t%s\n' "$(date -Is)"
    for u in "${MANAGED_UNITS[@]}"; do
      printf 'unit\t%s\t%s\t%s\n' "$u" "$(unit_enabled_state "$u")" "$(unit_active_state "$u")"
    done
    if [ -e "$UL_APT_CONF_DIR/$APT_DROPIN" ]; then
      printf 'aptconf\t%s\tpresent\n' "$APT_DROPIN"
    else
      printf 'aptconf\t%s\tabsent\n' "$APT_DROPIN"
    fi
    printf 'snap\trefresh.hold\t%s\n' "$(snap_hold_value)"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}

state_each_unit() {
  local kind a b c
  while IFS=$'\t' read -r kind a b c; do
    [ "$kind" = "unit" ] || continue
    printf '%s\t%s\t%s\n' "$a" "$b" "$c"
  done < "$STATE_FILE"
}

# state_field <kind> <key>; an empty <kind> matches a bare metadata line.
state_field() {
  local kind a b c
  while IFS=$'\t' read -r kind a b c; do
    if [ -z "$1" ] && [ "$kind" = "$2" ]; then printf '%s' "$a"; return 0; fi
    if [ "$kind" = "$1" ] && [ "$a" = "$2" ]; then printf '%s' "$b"; return 0; fi
  done < "$STATE_FILE"
  return 1
}

# ---------------------------------------------------------------- freeze ----

# Masking rather than merely disabling is deliberate: reinstalling a package
# re-enables its own timer, and a mask survives that.
freeze_units_from_state() {
  local name prior active
  while IFS=$'\t' read -r name prior active; do
    case "$prior" in
      not-found) continue ;;
      masked)    log "  $name was already masked - leaving it"; continue ;;
    esac
    # Already frozen: nothing to do. This makes `enforce` a true no-op at
    # boot when nothing has drifted, rather than re-stopping every unit.
    if [ "$(unit_enabled_state "$name")" = "masked" ]; then
      continue
    fi
    log "  freezing $name (was $prior/$active)"
    try systemctl stop "$name" || true
    # `systemctl disable` errors on a static unit, so only call it when the
    # unit genuinely carried an [Install] section.
    if [ "$prior" = "enabled" ]; then
      try systemctl disable "$name" || true
    fi
    try systemctl mask "$name" || true
  done < <(state_each_unit)
}

# The drop-in sorts last in apt.conf.d, so it wins without 10periodic ever
# being modified. That is what makes the exact-restore promise cheap for apt.
freeze_apt() {
  local target="$UL_APT_CONF_DIR/$APT_DROPIN"
  if [ "$DRY_RUN" -eq 1 ]; then
    log "  dry-run: would write $target"
    return 0
  fi
  if [ -e "$target" ] && [ "$(state_field aptconf "$APT_DROPIN" || true)" = "present" ]; then
    mkdir -p "$BACKUP_DIR"
    cp -a "$target" "$BACKUP_DIR/$APT_DROPIN"
    log "  backed up the pre-existing $APT_DROPIN"
  fi
  log "  writing $target"
  mkdir -p "$UL_APT_CONF_DIR"
  cat > "$target" <<'APTCONF'
// Written by update-lockdown. Removed automatically by `update-lockdown unlock`.
APT::Periodic::Enable "0";
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "0";
APTCONF
  chmod 644 "$target"
}

restore_apt() {
  local target="$UL_APT_CONF_DIR/$APT_DROPIN"
  if [ "$DRY_RUN" -eq 1 ]; then
    log "  dry-run: would remove $target"
    return 0
  fi
  rm -f "$target"
  if [ "$(state_field aptconf "$APT_DROPIN" || true)" = "present" ] && [ -e "$BACKUP_DIR/$APT_DROPIN" ]; then
    cp -a "$BACKUP_DIR/$APT_DROPIN" "$target"
    rm -f "$BACKUP_DIR/$APT_DROPIN"
    rmdir "$BACKUP_DIR" 2>/dev/null || true
    log "  restored the original $APT_DROPIN"
  else
    log "  removed $target"
  fi
}

# refresh.hold holds *automatic* refreshes only, so a manual `snap refresh`
# keeps working. `snap refresh --hold` would block manual refreshes too, which
# is why it is not used here. refresh.hold=forever needs snapd >= 2.58.
freeze_snap() {
  if ! command -v snap >/dev/null 2>&1; then
    log "  snapd not present - skipping"
    return 0
  fi
  log "  holding snap auto-refresh (manual 'snap refresh' still works)"
  try snap set system refresh.hold=forever || true
}

restore_snap() {
  command -v snap >/dev/null 2>&1 || return 0
  local prior
  prior="$(state_field snap refresh.hold || printf '__unset__')"
  if [ "$prior" = "__unset__" ]; then
    log "  clearing snap refresh.hold"
    try snap unset system refresh.hold || true
  else
    log "  restoring snap refresh.hold=$prior"
    try snap set system "refresh.hold=$prior" || true
  fi
}

# --------------------------------------------------------------- restore ----

restore_units_from_state() {
  local name prior active
  while IFS=$'\t' read -r name prior active; do
    case "$prior" in
      not-found) continue ;;
      masked)    log "  $name was masked before lockdown - leaving it masked"; continue ;;
    esac
    log "  restoring $name to $prior/$active"
    try systemctl unmask "$name" || true
    case "$prior" in
      enabled)  try systemctl enable "$name" || true ;;
      disabled) try systemctl disable "$name" || true ;;
      # static / indirect / enabled-runtime / generated: unmask is the whole job
    esac
    if [ "$active" = "active" ]; then
      try systemctl start "$name" || true
    fi
  done < <(state_each_unit)
}

# ------------------------------------------------------------- commands ----

cmd_lock() {
  need_root lock
  if is_locked; then
    die "already locked - run 'update-lockdown unlock' first (snapshot: $STATE_FILE)"
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run: would snapshot to $STATE_FILE, then freeze:"
    local u
    for u in "${MANAGED_UNITS[@]}"; do
      log "  dry-run: would mask $u (currently $(unit_enabled_state "$u"))"
    done
    log "  dry-run: would write $UL_APT_CONF_DIR/$APT_DROPIN"
    log "  dry-run: would set snap refresh.hold=forever"
    return 0
  fi
  state_write
  log "snapshot written to $STATE_FILE"
  freeze_units_from_state
  freeze_apt
  freeze_snap
  try systemctl daemon-reload || true
  [ "$FAILED" -eq 0 ] || die "$FAILED operation(s) failed"
  log ""
  log "Updates are locked down. Manual 'apt upgrade' and 'snap refresh' still work."
}
cmd_unlock() {
  need_root unlock
  if ! is_locked; then
    log "not locked - nothing to restore."
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run: would restore every item recorded in $STATE_FILE"
    return 0
  fi
  restore_units_from_state
  restore_apt
  restore_snap
  try systemctl daemon-reload || true
  if [ "$FAILED" -ne 0 ]; then
    die "$FAILED operation(s) failed - snapshot kept, re-run 'update-lockdown unlock'"
  fi
  rm -f "$STATE_FILE"
  log ""
  log "Updates restored to their pre-lockdown state."
}
cmd_status() {
  if ! is_locked; then
    printf 'update-lockdown: NOT LOCKED\n\n'
    printf 'Background updates are running normally.\n'
    printf 'Run `sudo update-lockdown lock` to freeze them.\n'
    return 1
  fi

  local drift=0 name prior active now want
  printf 'update-lockdown: LOCKED (since %s)\n\n' "$(state_field '' locked_at || printf 'unknown')"
  printf '%-38s %-12s %-12s %s\n' "ITEM" "NOW" "BEFORE" "RESULT"
  printf '%-38s %-12s %-12s %s\n' "------------------------------" "----------" "----------" "------"

  while IFS=$'\t' read -r name prior active; do
    [ "$prior" = "not-found" ] && continue
    now="$(unit_enabled_state "$name")"
    # A unit that was already masked before lockdown is correct when masked.
    if [ "$now" = "masked" ]; then
      printf '%-38s %-12s %-12s %s\n' "$name" "$now" "$prior" "ok"
    else
      printf '%-38s %-12s %-12s %s\n' "$name" "$now" "$prior" "DRIFT"
      drift=1
    fi
  done < <(state_each_unit)

  now="$(snap_hold_value)"
  want="$(state_field snap refresh.hold || printf 'unknown')"
  if [ "$now" = "forever" ]; then
    printf '%-38s %-12s %-12s %s\n' "snap refresh.hold" "$now" "$want" "ok"
  elif [ "$now" = "__unset__" ] && ! command -v snap >/dev/null 2>&1; then
    printf '%-38s %-12s %-12s %s\n' "snap refresh.hold" "n/a" "$want" "ok"
  else
    printf '%-38s %-12s %-12s %s\n' "snap refresh.hold" "$now" "$want" "DRIFT"
    drift=1
  fi

  if [ -e "$UL_APT_CONF_DIR/$APT_DROPIN" ]; then
    printf '%-38s %-12s %-12s %s\n' "apt $APT_DROPIN" "present" "$(state_field aptconf "$APT_DROPIN" || true)" "ok"
  else
    printf '%-38s %-12s %-12s %s\n' "apt $APT_DROPIN" "absent" "$(state_field aptconf "$APT_DROPIN" || true)" "DRIFT"
    drift=1
  fi

  if [ "$drift" -eq 1 ]; then
    printf '\nDrift detected: something has escaped the lockdown.\n'
    printf 'Run `sudo update-lockdown enforce` to re-apply it.\n'
    return 2
  fi
  printf '\nAll managed items are frozen. Manual apt/snap commands still work.\n'
  return 0
}
# Re-applies the frozen target for everything named in the state file, and
# never writes to the state file. Masks already survive a reboot on their own;
# this closes the gap where a package upgrade or a manual `systemctl unmask`
# reopens a channel between boots.
cmd_enforce() {
  need_root enforce
  if ! is_locked; then
    log "not locked - nothing to enforce."
    return 0
  fi
  log "re-applying lockdown from $STATE_FILE"
  freeze_units_from_state
  freeze_apt
  freeze_snap
  try systemctl daemon-reload || true
  [ "$FAILED" -eq 0 ] || die "$FAILED operation(s) failed"
  log "lockdown enforced."
}

main() {
  local args=()
  local a
  for a in "$@"; do
    case "$a" in
      --dry-run)    DRY_RUN=1 ;;
      --quiet|-q)   QUIET=1 ;;
      --help|-h)    usage; exit 0 ;;
      --version|-V) printf 'update-lockdown %s\n' "$VERSION"; exit 0 ;;
      -*)           die "unknown option: $a" ;;
      *)            args+=("$a") ;;
    esac
  done

  if [ "${#args[@]}" -eq 0 ]; then
    usage >&2
    exit 3
  fi

  case "${args[0]}" in
    lock)    cmd_lock ;;
    unlock)  cmd_unlock ;;
    status)  cmd_status ;;
    enforce) cmd_enforce ;;
    *)       die "unknown command: ${args[0]}" ;;
  esac
}

main "$@"
