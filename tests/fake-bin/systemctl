#!/usr/bin/env bash
# Test stub. Answers queries from $UL_FAKE_STATE, logs every call to $UL_FAKE_LOG.
printf 'systemctl %s\n' "$*" >> "$UL_FAKE_LOG"
cmd="${1:-}"
shift || true
lookup() { awk -F'\t' -v u="$1" -v f="$2" '$1==u{print $f}' "$UL_FAKE_STATE"; }
case "$cmd" in
  is-enabled)
    v="$(lookup "$1" 2)"
    if [ -z "$v" ] || [ "$v" = "not-found" ]; then exit 1; fi
    echo "$v"
    case "$v" in
      enabled|static|indirect|enabled-runtime|generated) exit 0 ;;
      *) exit 1 ;;
    esac
    ;;
  is-active)
    v="$(lookup "$1" 3)"
    if [ -z "$v" ]; then echo inactive; exit 3; fi
    echo "$v"
    [ "$v" = "active" ] && exit 0 || exit 3
    ;;
  *) exit 0 ;;
esac
